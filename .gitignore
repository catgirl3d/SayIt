client/src-tauri/transcribe-libs/

# ── Kiro IDE ──
.kiro/

# ── Node ──
node_modules/

# ── Rust build output ──
target/
# While the app is running it locks the ggml DLLs in target/debug and cargo fails with
# os error 32; building into a different target directory is the standard workaround
# (pitfalls #4) — keep the build output out of the repository.
target-check/
# Machine-local target directory override (the repository volume lacks space); never commit it
/.cargo/config.toml

# ── Python ──
__pycache__/
*.pyc
.venv*/

